<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment4_LiveData_JoClark.MainPage">

    <ScrollView>
        <VerticalStackLayout>
            <Label
                Text= "Quest Log"
                FontSize= "24" 
                />
            <Label 
                Text="Quests"
                />
            <Border>
                <CollectionView x:Name="QuestData" SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <HorizontalStackLayout>
                                <VerticalStackLayout WidthRequest="600">
                                    <Label Text="{Binding Title}"
                                           />
                                    <Label Text="{Binding Giver}"
                                            />       
                                </VerticalStackLayout>
                                <Label Text="{Binding Reward, StringFormat =' Reward: {0} Gold'}"
                                            />       
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No quests available" FontSize="20" 
                               />
                    </CollectionView.EmptyView>
                </CollectionView>
            </Border>
            <Entry x:Name="TitleEntry"
                   Placeholder="Enter quest title"
                   />
            <Entry x:Name="GiverEntry"
                   Placeholder="Enter quest giver"
                   />
            <Entry x:Name="RewardEntry"
                   Placeholder="Enter quest reward"
                   Keyboard="Numeric"
                   />
            <Button Text="Add Quest"
                    Clicked="OnAddQuestClicked"
                    />
            <Button Text="Remove Quest"
                    Clicked="OnRemoveQuestClicked"
                    />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
